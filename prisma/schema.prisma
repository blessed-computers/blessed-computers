generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id          String   @id @default(cuid())
  name        String
  price       Int
  description String?
  type        String
  company     String
  imageUrl    String?
  createdAt   DateTime @default(now())
}
